/* ===== 喵星驻地球办事处 · 全局样式 ===== */
page {
  background-color: #f5f0e8;
  color: #3d3529;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 14px;
}

/* 容器 */
.container {
  padding: 16rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #fffdf8;
  border: 1rpx solid #e8dfd3;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(61,53,41,0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.card-title .ic {
  width: 36rpx;
  height: 36rpx;
}

/* 统计卡（三列） */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.stat-item {
  flex: 1;
  background: linear-gradient(135deg, #fffdf8, #f5f0e8);
  border: 1rpx solid #e8dfd3;
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #c89060;
  font-variant-numeric: tabular-nums;
}
.stat-lab {
  font-size: 22rpx;
  color: #8a8074;
  margin-top: 4rpx;
}

/* Hero 区域 */
.hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  margin-bottom: 16rpx;
}
.hero-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}
.hero-text .title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3d3529;
}
.hero-text .sub {
  font-size: 24rpx;
  color: #8a8074;
  margin-top: 4rpx;
}

/* 功能卡片网格 */
.func-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.func-card {
  background: #fffdf8;
  border: 1rpx solid #e8dfd3;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.func-card:active { background: #f5f0e8; }
.func-ic { font-size: 40rpx; }
.func-name { font-size: 22rpx; color: #3d3529; }
.func-desc { font-size: 18rpx; color: #8a8074; }

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  background: #fffdf8;
  border: 1rpx solid #e8dfd3;
  color: #3d3529;
}
.btn-primary {
  background: #8b9a7f;
  color: #fff;
  border-color: transparent;
}
.btn-primary:active { background: #6b7a62; }
.btn-ai {
  background: linear-gradient(135deg, #8b7fd6, #c89060);
  color: #fff;
  border-color: transparent;
}
.btn-small {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  border-radius: 14rpx;
}

/* 输入框 */
.input-box {
  background: #faf7f2;
  border: 1rpx solid #e8dfd3;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}
.textarea-box {
  background: #faf7f2;
  border: 1rpx solid #e8dfd3;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
}

/* 标签 */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #f5f0e8;
  color: #8a8074;
  border: 1rpx solid #e8dfd3;
}

/* 三段式网格 */
.tri-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}
.tri-col { display: flex; flex-direction: column; gap: 8rpx; }
.tri-label { font-size: 22rpx; font-weight: 600; color: #c89060; }

/* AI 总结框 */
.ai-box {
  margin-top: 16rpx;
  border: 1rpx solid rgba(200,144,96,0.4);
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(200,144,96,0.08), #fffdf8);
  padding: 20rpx;
}
.ai-badge { font-size: 22rpx; font-weight: 600; color: #c89060; }
.ai-text { white-space: pre-wrap; line-height: 1.7; font-size: 26rpx; margin-top: 8rpx; }

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #8a8074;
  font-size: 26rpx;
}

/* 底部分隔线 */
.bottom-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #e8dfd3;
}
.bottom-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.fade-in { animation: fadeIn 0.35s ease both; }
