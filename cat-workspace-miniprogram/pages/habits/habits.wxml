<view class="container">
  <view class="card">
    <view class="card-title"><text>🐾</text><text>习惯健康打卡</text></view>
    <block wx:if="{{habits.length > 0}}">
      <view wx:for="{{habits}}" wx:key="id" style="margin-bottom:24rpx;padding-bottom:20rpx;border-bottom:1rpx solid #e8dfd3">
        <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx">
          <text style="font-size:30rpx;font-weight:600">{{item.name}}</text>
          <view style="display:flex;gap:12rpx;align-items:center">
            <text wx:if="{{item.mode==='count'}}" style="font-size:28rpx;color:#c89060;font-weight:700">{{item.todayVal||0}}/{{item.target}}{{item.unit}}</text>
            <button class="btn btn-primary btn-small" bindtap="checkin" data-id="{{item.id}}">
              {{item.checked?'取消':'打卡'}}
            </button>
          </view>
        </view>
        <!-- 30天热力图简化版 -->
        <view style="display:flex;gap:4rpx;flex-wrap:wrap">
          <view wx:for="{{item.history}}" wx:for-item="day" wx:key="*this"
                style="width:20rpx;height:20rpx;border-radius:4rpx;background:{{day?'#8b9a7f':'#f0ebe3'}}"></view>
        </view>
      </view>
    </block>
    <view wx:else class="empty-state">还没有习惯，去添加一个吧 🐱</view>

    <!-- 添加习惯 -->
    <view style="margin-top:16rpx;display:flex;gap:12rpx;align-items:center">
      <input class="input-box" placeholder="新习惯名称…" value="{{newName}}" bindinput="onInput" style="flex:1"/>
      <picker mode="selector" range="{{modes}}" value="{{modeIdx}}" bindchange="onModeChange" style="font-size:24rpx;color:#c89060">
        <text>{{modes[modeIdx]}}</text>
      </picker>
      <button class="btn btn-primary" bindtap="addHabit" size="mini">添加</button>
    </view>
  </view>
</view>
