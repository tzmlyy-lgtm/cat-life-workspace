<view class="container">
  <!-- 月度概览 -->
  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-num" style="color:#e2886b">¥{{monthOut}}</text>
      <text class="stat-lab">本月支出</text>
    </view>
    <view class="stat-item">
      <text class="stat-num" style="color:#7fa07f">¥{{monthIn}}</text>
      <text class="stat-lab">本月收入</text>
    </view>
    <view class="stat-item">
      <text class="stat-num" style="color:#3d3529">¥{{balance}}</text>
      <text class="stat-lab">结余</text>
    </view>
  </view>

  <!-- 记账表单 -->
  <view class="card">
    <view class="card-title"><text>💰</text><text>记一笔</text></view>
    <view style="display:flex;gap:12rpx;margin-bottom:12rpx">
      <view wx:for="{{['expense','income']}}" wx:key="*this"
            class="tag" bindtap="setType" data-type="{{item}}"
            style="{{formType===item?(item==='expense'?'background:#e2886b;color:#fff;border-color:#e2886b':'background:#7fa07f;color:#fff;border-color:#7fa07f'):''}}">
        {{item==='expense'?'支出':'收入'}}
      </view>
    </view>
    <input class="input-box" placeholder="金额" type="digit" value="{{formAmount}}" bindinput="onAmtInput" style="margin-bottom:12rpx"/>
    <input class="input-box" placeholder="分类（餐饮/交通/工资…）" value="{{formCategory}}" bindinput="onCatInput" style="margin-bottom:12rpx"/>
    <input class="input-box" placeholder="备注" value="{{formNote}}" bindinput="onNoteInput" style="margin-bottom:12rpx"/>
    <button class="btn btn-primary" bindtap="saveRecord" size="mini">保存</button>
  </view>

  <!-- 流水列表 -->
  <view class="card">
    <view class="card-title"><text>📋</text><text>最近流水</text></view>
    <block wx:if="{{records.length > 0}}">
      <view wx:for="{{records}}" wx:key="id" style="display:flex;align-items:center;padding:14rpx 0;border-bottom:1rpx solid #e8dfd3">
        <text style="font-size:32rpx;margin-right:12rpx">{{item.type==='expense'?'🔻':'🔺'}}</text>
        <view style="flex:1">
          <text style="font-size:28rpx">{{item.category||'未分类'}} · {{item.note||''}}</text>
          <text style="font-size:22rpx;color:#8a8074;display:block">{{item.date}}</text>
        </view>
        <text style="font-size:30rpx;font-weight:700;{{item.type==='expense'?'color:#e2886b':'color:#7fa07f'}}">{{item.type==='expense'?'-':'+'}}¥{{item.amount}}</text>
        <text class="btn btn-small" catchtap="delRec" data-id="{{item.id}}">删</text>
      </view>
    </block>
    <view wx:else class="empty-state">还没有记账记录 🐱</view>
  </view>
</view>
